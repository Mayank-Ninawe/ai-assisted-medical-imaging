# Copy this file to .env for local development and fill in local values.
# Never commit .env or real credentials.

APP_ENV=development
LOG_LEVEL=INFO

# Local development defaults; update only when the relevant service is implemented.
DATABASE_URL=sqlite:///./app.db

# Orthanc local demo settings. Replace credentials locally if authentication is enabled.
ORTHANC_URL=http://localhost:8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=

# Local paths. Do not store datasets or model weights in Git.
DATA_DIR=./data
CLASSIFICATION_MODEL_PATH=./models/classification.pt
SEGMENTATION_MODEL_PATH=./models/segmentation.pt

# Upload limit in megabytes. The backend must enforce this when implemented.
MAX_UPLOAD_SIZE_MB=50

# Frontend API base URL for local development.
VITE_API_BASE_URL=http://localhost:8000